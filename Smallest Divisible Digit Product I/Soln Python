class Solution:
    def smallestNumber(self, n: int, t: int) -> int:
        prod=1
        copy1=copy2=0
        while(True):
            prod=1
            copy1=copy2=n
            while(copy1!=0):
                prod*=copy1%10
                copy1//=10
            if(prod%t==0):
                return copy2
            else:
                n+=1
